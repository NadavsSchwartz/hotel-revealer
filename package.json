{
  "name": "hotel-revealer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace frontend && node scripts/compress-build.mjs",
    "start": "node backend/server.js",
    "test": "node --test backend/domain/*.test.js backend/destinations/*.test.js backend/provider/*.test.js backend/*.test.js frontend/src/traveler/*.test.js scripts/check-health.test.mjs",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "provider:reset": "node scripts/reset-provider.mjs"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "express": "4.22.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "rc-select": "14.4.3"
  }
}
