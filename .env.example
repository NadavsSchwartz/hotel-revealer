NODE_ENV=production
PORT=5000
# Only provider cooldown/block state, not hotel/search data.
PROVIDER_STATE_FILE=./var/provider-state.json
# First-party usage records. Defaults to usage/ beside PROVIDER_STATE_FILE.
# Keep on the same persistent mount on the VPS; the report job reads this directory.
USAGE_DATA_DIR=./var/usage
# Normal public Priceline integration; use disabled for offline development/tests.
HOTEL_PROVIDER=priceline
